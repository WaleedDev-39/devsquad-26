# ─────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY — accepts either a Groq key (free) or a real OpenAI key
#
#   Groq key  (free, fast): starts with gsk_  → get one at https://console.groq.com
#   OpenAI key (paid):      starts with sk-   → get one at https://platform.openai.com
#
# The system auto-detects which one you paste and routes accordingly.
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=gsk_your_groq_key_here

# Tavily Search API Key — 1,000 free searches/month at https://app.tavily.com
TAVILY_API_KEY=tvly-your_tavily_key_here
