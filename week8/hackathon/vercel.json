{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    {
      "src": "backend/src/main.ts",
      "use": "@vercel/node",
      "config": { "includeFiles": ["backend/src/**"] }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/src/main.ts" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
