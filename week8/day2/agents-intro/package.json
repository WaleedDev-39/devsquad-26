{
  "name": "agents-intro",
  "version": "1.0.0",
  "description": "Multi-agent CLI assistant built with the OpenAI Agents SDK — Router, Math, Programming, and General Q&A agents with tools, handoffs, and guardrails.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "hello": "tsx src/hello-world.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:run": "tsc && node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openai-agents",
    "agentic-ai",
    "multi-agent",
    "cli",
    "typescript",
    "handoffs",
    "guardrails",
    "tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.1.0",
    "@openai/agents": "^0.0.11",
    "dotenv": "^16.0.0",
    "openai": "^5.23.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
